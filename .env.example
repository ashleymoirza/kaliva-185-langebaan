# ─────────────────────────────────────────────────────────────
# Kaliva 185 Langebaan — environment template. Copy to .env.local
# and fill in real values. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, PayFast return URLs, sitemap)
NEXT_PUBLIC_SITE_URL="https://kaliva185.duckdns.org"

# ── Database (PostgreSQL) ─────────────────────────────────────
# Leave blank to run in "demo mode" (units render, bookings return a clear error).
DATABASE_URL="postgresql://user:password@localhost:5432/kaliva185?schema=public"

# ── Admin authentication ──────────────────────────────────────
# 32+ char random string: openssl rand -base64 48
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"
ADMIN_EMAIL="admin@kaliva185.duckdns.org"
# bcrypt hash of the admin password: node -e "console.log(require('bcryptjs').hashSync('yourpass',12))"
ADMIN_PASSWORD_HASH="$2a$12$replace.with.a.real.bcrypt.hash"

# ── Meta (Facebook) Pixel ─────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=""

# ── PayFast (South Africa) ────────────────────────────────────
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
# Passphrase is optional but recommended in the PayFast dashboard
PAYFAST_PASSPHRASE=""
# Set to "true" to hit the PayFast sandbox
PAYFAST_SANDBOX="true"

# ── Stripe (international cards) ──────────────────────────────
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Ozow (South Africa) ───────────────────────────────────────
OZOW_SITE_CODE=""
OZOW_PRIVATE_KEY=""
OZOW_API_URL="https://api.ozow.com"  # Use https://api-sandbox.ozow.com for testing
OZOW_IS_TEST="true"

# ── Redis (for BullMQ job queues) ─────────────────────────────
# Use REDIS_URL for connection string (e.g., redis://localhost:6379)
# Or individual settings:
REDIS_HOST="localhost"
REDIS_PORT="6379"
# REDIS_PASSWORD=""  # Optional
# REDIS_DB="0"       # Optional

# ── Ollama (Local AI for welcome messages) ────────────────────
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
# OLLAMA_TIMEOUT="60000"   # Optional: request timeout in ms
# OLLAMA_MAX_RETRIES="3"   # Optional

# ── Contact / notifications ───────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="27821234567"
CONTACT_EMAIL="stay@kaliva185.duckdns.org"

# ── Owner notifications (pick any; all optional) ──────────────────
# Easiest: Telegram. Create a bot with @BotFather, then message your bot and
# get your chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Or a webhook (Slack/Discord/Make/n8n/Zapier — can relay to WhatsApp/SMS)
NOTIFY_WEBHOOK_URL=""
# Or email via Resend (https://resend.com)
RESEND_API_KEY=""
NOTIFY_EMAIL_TO="you@example.com"
NOTIFY_EMAIL_FROM="Kaliva 185 <bookings@kaliva185.duckdns.org>"
