# Kaliva 185 Langebaan — Production Environment Configuration
# Copy this file to /etc/kaliva185/production.env on the VPS
# chown kaliva:kaliva /etc/kaliva185/production.env && chmod 600 /etc/kaliva185/production.env

# ─────────────────────────────────────────────────────────────
# Public site URL (production domain)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://kaliva185.duckdns.org"

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://kaliva:CHANGE_ME_SECURE_PASSWORD@localhost:5432/kaliva185_prod?schema=public"

# ─────────────────────────────────────────────────────────────
# Admin authentication
# ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS"
ADMIN_EMAIL="admin@kaliva185.duckdns.org"
# Generate bcrypt hash with: node -e "console.log(require('bcryptjs').hashSync('yourpass',12))"
ADMIN_PASSWORD_HASH="$2a$12$CHANGE_ME_TO_A_REAL_BCRYPT_HASH"

# ─────────────────────────────────────────────────────────────
# Meta (Facebook) Pixel - Production
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID="CHANGE_ME_TO_PRODUCTION_PIXEL_ID"

# ─────────────────────────────────────────────────────────────
# PayFast (South Africa) — PRODUCTION MODE
# ─────────────────────────────────────────────────────────────
PAYFAST_MERCHANT_ID="CHANGE_ME_TO_PRODUCTION_MERCHANT_ID"
PAYFAST_MERCHANT_KEY="CHANGE_ME_TO_PRODUCTION_MERCHANT_KEY"
PAYFAST_PASSPHRASE="CHANGE_ME_TO_PRODUCTION_PASSPHRASE"
PAYFAST_SANDBOX="false"

# ─────────────────────────────────────────────────────────────
# Stripe (international cards) — PRODUCTION MODE
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_CHANGE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_CHANGE_ME"

# ─────────────────────────────────────────────────────────────
# Ozow (South Africa) — PRODUCTION MODE
# ─────────────────────────────────────────────────────────────
# Get credentials from: https://www.ozow.com
OZOW_SITE_CODE="CHANGE_ME_TO_PRODUCTION_SITE_CODE"
OZOW_PRIVATE_KEY="CHANGE_ME_TO_PRODUCTION_PRIVATE_KEY"
OZOW_API_URL="https://api.ozow.com"
OZOW_IS_TEST="false"

# ─────────────────────────────────────────────────────────────
# Redis (for BullMQ job queues)
# ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────
# Ollama (Local AI for welcome messages)
# ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_TIMEOUT="60000"
OLLAMA_MAX_RETRIES="3"

# ─────────────────────────────────────────────────────────────
# Contact / notifications
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="27821234567"
CONTACT_EMAIL="stay@kaliva185.duckdns.org"

# ─────────────────────────────────────────────────────────────
# Owner notifications (pick any; all optional)
# ─────────────────────────────────────────────────────────────
# Telegram: Create a bot with @BotFather, get chat_id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN="CHANGE_ME"
TELEGRAM_CHAT_ID="CHANGE_ME"

# Webhook (Slack/Discord/Make/n8n/Zapier)
NOTIFY_WEBHOOK_URL=""

# Email via Resend (https://resend.com)
RESEND_API_KEY="CHANGE_ME"
NOTIFY_EMAIL_TO="bookings@kaliva185.duckdns.org"
NOTIFY_EMAIL_FROM="Kaliva 185 <bookings@kaliva185.duckdns.org>"