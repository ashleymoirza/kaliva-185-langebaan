# Kaliva 185 Langebaan — Staging Environment Configuration
# Copy this file to /etc/kaliva185/staging.env on the VPS
# chown kaliva:kaliva /etc/kaliva185/staging.env && chmod 600 /etc/kaliva185/staging.env

# ─────────────────────────────────────────────────────────────
# Public site URL (staging domain)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://staging.kaliva185.duckdns.org"

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://kaliva:CHANGE_ME_SECURE_PASSWORD@localhost:5432/kaliva185_staging?schema=public"

# ─────────────────────────────────────────────────────────────
# Admin authentication
# ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS"
ADMIN_EMAIL="admin@kaliva185.duckdns.org"
# Generate bcrypt hash with: node -e "console.log(require('bcryptjs').hashSync('yourpass',12))"
ADMIN_PASSWORD_HASH="$2a$12$CHANGE_ME_TO_A_REAL_BCRYPT_HASH"

# ─────────────────────────────────────────────────────────────
# Meta (Facebook) Pixel - Staging
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=""

# ─────────────────────────────────────────────────────────────
# PayFast (South Africa) — SANDBOX MODE
# ─────────────────────────────────────────────────────────────
PAYFAST_MERCHANT_ID="10000100"
PAYFAST_MERCHANT_KEY="46f0cd694581a"
PAYFAST_PASSPHRASE="CHANGE_ME_OR_LEAVE_EMPTY"
PAYFAST_SANDBOX="true"

# ─────────────────────────────────────────────────────────────
# Stripe (international cards) — TEST MODE
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_CHANGE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_CHANGE_ME"

# ─────────────────────────────────────────────────────────────
# Ozow (South Africa) — SANDBOX MODE
# ─────────────────────────────────────────────────────────────
# Get credentials from: https://sandbox.ozow.com
OZOW_SITE_CODE="CHANGE_ME_TO_SANDBOX_SITE_CODE"
OZOW_PRIVATE_KEY="CHANGE_ME_TO_SANDBOX_PRIVATE_KEY"
OZOW_API_URL="https://api-sandbox.ozow.com"
OZOW_IS_TEST="true"

# ─────────────────────────────────────────────────────────────
# Redis (for BullMQ job queues)
# ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────
# Ollama (Local AI for welcome messages)
# ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_TIMEOUT="60000"
OLLAMA_MAX_RETRIES="3"

# ─────────────────────────────────────────────────────────────
# Contact / notifications
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="27821234567"
CONTACT_EMAIL="stay@kaliva185.duckdns.org"

# ─────────────────────────────────────────────────────────────
# Owner notifications (pick any; all optional)
# ─────────────────────────────────────────────────────────────
# Telegram: Create a bot with @BotFather, get chat_id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Webhook (Slack/Discord/Make/n8n/Zapier)
NOTIFY_WEBHOOK_URL=""

# Email via Resend (https://resend.com)
RESEND_API_KEY=""
NOTIFY_EMAIL_TO="staging@kaliva185.duckdns.org"
NOTIFY_EMAIL_FROM="Kaliva 185 Staging <staging@kaliva185.duckdns.org>"