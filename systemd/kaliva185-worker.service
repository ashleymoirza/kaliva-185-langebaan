[Unit]
Description=Kaliva 185 Langebaan Background Worker (Production)
Documentation=https://github.com/kaliva-185/kaliva-185-langebaan
After=network.target postgresql.service redis.service ollama.service kaliva185-production.service
Wants=postgresql.service redis.service ollama.service

[Service]
Type=simple
User=kaliva
Group=kaliva
WorkingDirectory=/var/www/kaliva185-prod
Environment=NODE_ENV=production
# Environment variables loaded from /etc/kaliva185/production.env
EnvironmentFile=-/etc/kaliva185/production.env
ExecStart=/usr/bin/npx tsx lib/queue/worker-entry.ts
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=255
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kaliva185-worker

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryLimit=1G
CPUQuota=100%

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www/kaliva185-prod /var/log/kaliva185 /tmp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Restart on crash
StartLimitIntervalSec=60
StartLimitBurst=3

[Install]
WantedBy=multi-user.target